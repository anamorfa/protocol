{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anamorfa.github.io/protocol/schemas/v0/turn.schema.json",
  "title": "Turn",
  "description": "Whose turn it is and what they may do. actor is null and available_actions empty when the fight is over.",
  "type": "object",
  "required": ["actor", "available_actions"],
  "properties": {
    "actor": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$" },
    "available_actions": { "type": "array", "items": { "$ref": "available-action.schema.json" } }
  },
  "additionalProperties": false
}
