{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anamorfa.github.io/protocol/schemas/v0/event.schema.json",
  "title": "Event",
  "description": "Something that happened in the world or in a fight. Events carry every roll and every step so clients can animate them without knowing the rules.",
  "type": "object",
  "oneOf": [
    { "type": "object", "required": ["e", "entity", "d20", "total"], "additionalProperties": false,
      "properties": { "e": { "const": "initiative_rolled" }, "entity": { "$ref": "#/$defs/id" },
                      "d20": { "$ref": "#/$defs/d20" }, "total": { "type": "integer" } } },
    { "type": "object", "required": ["e", "round"], "additionalProperties": false,
      "properties": { "e": { "const": "round_started" }, "round": { "type": "integer", "minimum": 1 } } },
    { "type": "object", "required": ["e", "entity"], "additionalProperties": false,
      "properties": { "e": { "const": "turn_started" }, "entity": { "$ref": "#/$defs/id" } } },
    { "type": "object", "required": ["e", "entity", "from", "to"], "additionalProperties": false,
      "properties": { "e": { "const": "moved" }, "entity": { "$ref": "#/$defs/id" },
                      "from": { "$ref": "common.schema.json#/$defs/line" }, "to": { "$ref": "common.schema.json#/$defs/line" } } },
    { "type": "object", "required": ["e", "actor", "target", "essence", "form", "d20", "total", "defense", "result"],
      "additionalProperties": false,
      "properties": { "e": { "const": "attack_rolled" }, "actor": { "$ref": "#/$defs/id" }, "target": { "$ref": "#/$defs/id" },
                      "essence": { "$ref": "common.schema.json#/$defs/essence" },
                      "form": { "$ref": "common.schema.json#/$defs/form" },
                      "d20": { "$ref": "#/$defs/d20" }, "total": { "type": "integer" }, "defense": { "type": "integer" },
                      "result": { "enum": ["hit", "miss", "critical"] } } },
    { "type": "object", "required": ["e", "target", "rolled", "weakness", "resisted", "absorbed", "dealt", "hp"],
      "additionalProperties": false,
      "properties": { "e": { "const": "damaged" }, "target": { "$ref": "#/$defs/id" },
                      "rolled": { "$ref": "#/$defs/count" }, "weakness": { "$ref": "#/$defs/count" },
                      "resisted": { "$ref": "#/$defs/count" }, "absorbed": { "$ref": "#/$defs/count" },
                      "dealt": { "$ref": "#/$defs/count" }, "hp": { "$ref": "#/$defs/count" } } },
    { "type": "object", "required": ["e", "entity", "amount", "remaining"], "additionalProperties": false,
      "properties": { "e": { "const": "ink_spent" }, "entity": { "$ref": "#/$defs/id" },
                      "amount": { "$ref": "#/$defs/count" }, "remaining": { "$ref": "#/$defs/count" } } },
    { "type": "object", "required": ["e", "entity", "amount", "remaining"], "additionalProperties": false,
      "properties": { "e": { "const": "ink_gained" }, "entity": { "$ref": "#/$defs/id" },
                      "amount": { "$ref": "#/$defs/count" }, "remaining": { "$ref": "#/$defs/count" } } },
    { "type": "object", "required": ["e", "entity", "from", "to"], "additionalProperties": false,
      "description": "from and to are 0-based gear set indexes.",
      "properties": { "e": { "const": "reshaped" }, "entity": { "$ref": "#/$defs/id" },
                      "from": { "$ref": "#/$defs/count" }, "to": { "$ref": "#/$defs/count" } } },
    { "type": "object", "required": ["e", "actor", "target"], "additionalProperties": false,
      "properties": { "e": { "const": "fixed" }, "actor": { "$ref": "#/$defs/id" }, "target": { "$ref": "#/$defs/id" } } },
    { "type": "object", "required": ["e", "entity"], "additionalProperties": false,
      "properties": { "e": { "const": "downed" }, "entity": { "$ref": "#/$defs/id" } } },
    { "type": "object", "required": ["e", "entity"], "additionalProperties": false,
      "properties": { "e": { "const": "turn_ended" }, "entity": { "$ref": "#/$defs/id" } } },
    { "type": "object", "required": ["e", "entity"], "additionalProperties": false,
      "description": "A Scribe fled the Rift from the rear line.",
      "properties": { "e": { "const": "fled" }, "entity": { "$ref": "#/$defs/id" } } },
    { "type": "object", "required": ["e", "winner"], "additionalProperties": false,
      "description": "winner is null when every Scribe still standing fled.",
      "properties": { "e": { "const": "combat_ended" },
                      "winner": { "oneOf": [{ "$ref": "common.schema.json#/$defs/side" }, { "type": "null" }] } } },

    { "type": "object", "required": ["e", "entity", "path"], "additionalProperties": false,
      "description": "The steps the Scribe is about to walk, one per tick.",
      "properties": { "e": { "const": "path_planned" }, "entity": { "$ref": "#/$defs/id" },
                      "path": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/tile" }, "minItems": 1 } } },
    { "type": "object", "required": ["e", "entity", "from", "to", "facing"], "additionalProperties": false,
      "properties": { "e": { "const": "stepped" }, "entity": { "$ref": "#/$defs/id" },
                      "from": { "$ref": "common.schema.json#/$defs/tile" }, "to": { "$ref": "common.schema.json#/$defs/tile" },
                      "facing": { "$ref": "common.schema.json#/$defs/facing" } } },
    { "type": "object", "required": ["e", "entity", "reason"], "additionalProperties": false,
      "description": "arrived: the path is done; stopped: asked to, rested or entered a Rift; blocked: something stands on the next tile; passage: a passage ended the walk early.",
      "properties": { "e": { "const": "movement_stopped" }, "entity": { "$ref": "#/$defs/id" },
                      "reason": { "enum": ["arrived", "stopped", "blocked", "passage"] } } },
    { "type": "object", "required": ["e", "map", "tiles"], "additionalProperties": false,
      "description": "Tiles of the map seen for the first time. They stay known. Right after map_changed or respawned it carries every known tile of that map instead, so a client that kept none of them can draw it again.",
      "properties": { "e": { "const": "tiles_revealed" }, "map": { "$ref": "#/$defs/id" },
                      "tiles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/known_tile" }, "minItems": 1 } } },
    { "type": "object", "required": ["e", "entity"], "additionalProperties": false,
      "description": "An Anchor, a passage or a group came into sight.",
      "properties": { "e": { "const": "entity_seen" }, "entity": { "$ref": "common.schema.json#/$defs/world_entity" } } },
    { "type": "object", "required": ["e", "entity"], "additionalProperties": false,
      "description": "An Anchor, a passage or a group left the Scribe's sight, or is gone: forget it.",
      "properties": { "e": { "const": "entity_lost" }, "entity": { "$ref": "#/$defs/id" } } },
    { "type": "object", "required": ["e", "entity", "map", "at"], "additionalProperties": false,
      "description": "A passage took the Scribe to another map. A tiles_revealed with every known tile of the new map follows.",
      "properties": { "e": { "const": "map_changed" }, "entity": { "$ref": "#/$defs/id" },
                      "map": { "$ref": "common.schema.json#/$defs/map_ref" }, "at": { "$ref": "common.schema.json#/$defs/tile" } } },
    { "type": "object", "required": ["e", "entity", "anchor"], "additionalProperties": false,
      "description": "The Scribe will come back to this Anchor after a lost Rift.",
      "properties": { "e": { "const": "anchor_bound" }, "entity": { "$ref": "#/$defs/id" }, "anchor": { "$ref": "#/$defs/id" } } },
    { "type": "object", "required": ["e", "entity", "hp", "ink"], "additionalProperties": false,
      "properties": { "e": { "const": "rested" }, "entity": { "$ref": "#/$defs/id" },
                      "hp": { "$ref": "#/$defs/count" }, "ink": { "$ref": "#/$defs/count" } } },
    { "type": "object", "required": ["e", "group", "encounter", "participants"], "additionalProperties": false,
      "description": "A Rift opened with a group. participants are as they enter, before the fight's opening events that follow.",
      "properties": { "e": { "const": "rift_entered" }, "group": { "$ref": "#/$defs/id" },
                      "encounter": { "$ref": "common.schema.json#/$defs/named" },
                      "participants": { "type": "array", "items": { "oneOf": [{ "$ref": "snapshot.schema.json#/$defs/scribe" },
                                                                              { "$ref": "snapshot.schema.json#/$defs/formless" }] } } } },
    { "type": "object", "required": ["e", "group", "outcome", "reward"], "additionalProperties": false,
      "description": "The Scribe is back on the map. won: the group is gone; lost: a respawned event follows; fled: the group stays, wounded. The reward comes only with a win.",
      "properties": { "e": { "const": "rift_ended" }, "group": { "$ref": "#/$defs/id" },
                      "outcome": { "enum": ["won", "lost", "fled"] },
                      "reward": { "oneOf": [{ "type": "null" },
                        { "type": "object", "additionalProperties": false, "required": ["xp", "seals"],
                          "properties": { "xp": { "$ref": "#/$defs/count" }, "seals": { "$ref": "#/$defs/count" } } }] } },
      "if": { "properties": { "outcome": { "const": "won" } }, "required": ["outcome"] },
      "then": { "properties": { "reward": { "type": "object" } } },
      "else": { "properties": { "reward": { "type": "null" } } } },
    { "type": "object", "required": ["e", "entity", "anchor", "map", "at", "hp", "ink"], "additionalProperties": false,
      "description": "After a lost Rift the Scribe is back at its bound Anchor with full hp and Ink. A tiles_revealed with every known tile of that map follows.",
      "properties": { "e": { "const": "respawned" }, "entity": { "$ref": "#/$defs/id" }, "anchor": { "$ref": "#/$defs/id" },
                      "map": { "$ref": "common.schema.json#/$defs/map_ref" }, "at": { "$ref": "common.schema.json#/$defs/tile" },
                      "hp": { "$ref": "#/$defs/count" }, "ink": { "$ref": "#/$defs/count" } } }
  ],
  "$defs": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "d20": { "type": "integer", "minimum": 1, "maximum": 20 },
    "count": { "type": "integer", "minimum": 0 }
  }
}
