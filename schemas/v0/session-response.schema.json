{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anamorfa.github.io/protocol/schemas/v0/session-response.schema.json",
  "title": "Create session response",
  "description": "Body of the 201 answer to POST /sessions. The token opens /play?token=... A character's session has character_id and the map it stands on; a training session has the encounter.",
  "type": "object",
  "required": ["session_id", "token", "character_id", "map", "encounter"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "token": { "type": "string", "minLength": 16 },
    "character_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "map": { "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
    "encounter": { "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] }
  },
  "additionalProperties": false,
  "oneOf": [
    { "properties": { "character_id": { "type": "string" }, "map": { "type": "string" }, "encounter": { "type": "null" } } },
    { "properties": { "character_id": { "type": "null" }, "map": { "type": "null" }, "encounter": { "type": "string" } } }
  ]
}
