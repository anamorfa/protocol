{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anamorfa.github.io/protocol/schemas/v0/rules.schema.json",
  "title": "Rules",
  "description": "Body of GET /rules: what clients need to explain the game and build gear sets, never to decide a fight.",
  "type": "object",
  "required": ["wheel", "forms", "essences", "weakness_bonus_percent", "max_sets", "ink_cost", "ink_gain", "world"],
  "properties": {
    "wheel": {
      "description": "Each form maps to the forms it is strong against.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/form" },
      "additionalProperties": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/form" } }
    },
    "forms": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/form" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["name_key", "slot", "grips", "reach"],
        "properties": {
          "name_key": { "$ref": "common.schema.json#/$defs/text_key" },
          "slot": { "$ref": "common.schema.json#/$defs/slot" },
          "grips": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/grip" }, "minItems": 1 },
          "pairs_with": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/form" }, "uniqueItems": true, "description": "Off-hand forms only: the main-hand forms this off hand can be held with." },
          "reach": {
            "type": "object", "additionalProperties": false, "required": ["from", "to"],
            "properties": {
              "from": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/line" } },
              "to": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/line" } }
            }
          }
        }
      }
    },
    "essences": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/essence" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["name_key", "forms"],
        "properties": {
          "name_key": { "$ref": "common.schema.json#/$defs/text_key" },
          "forms": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/form" } }
        }
      }
    },
    "weakness_bonus_percent": { "type": "integer", "minimum": 0 },
    "max_sets": { "type": "integer", "minimum": 1 },
    "ink_cost": {
      "type": "object", "additionalProperties": false, "required": ["reshape", "fix"],
      "properties": { "reshape": { "type": "integer", "minimum": 0 }, "fix": { "type": "integer", "minimum": 0 } }
    },
    "ink_gain": {
      "type": "object", "additionalProperties": false, "required": ["every_rounds", "per_downed_enemy"],
      "properties": {
        "every_rounds": { "type": "integer", "minimum": 1 },
        "per_downed_enemy": { "type": "integer", "minimum": 0 }
      }
    },
    "world": {
      "description": "What clients need to draw the world: terrain, maps and the pace of a walk.",
      "type": "object", "additionalProperties": false,
      "required": ["tick_ms", "vision_radius", "starting_map", "terrains", "maps"],
      "properties": {
        "tick_ms": { "description": "Milliseconds between two steps of a walking Scribe.", "type": "integer", "minimum": 1 },
        "vision_radius": { "description": "How far a Scribe sees, in steps.", "type": "integer", "minimum": 1 },
        "starting_map": { "$ref": "common.schema.json#/$defs/id" },
        "terrains": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/content_id" },
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["name_key", "tags", "blocks_movement", "blocks_vision", "water"],
            "properties": {
              "name_key": { "$ref": "common.schema.json#/$defs/text_key" },
              "tags": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
              "blocks_movement": { "type": "boolean" }, "blocks_vision": { "type": "boolean" }, "water": { "type": "boolean" }
            }
          }
        },
        "maps": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/map_ref" }
        }
      }
    }
  },
  "additionalProperties": false
}
