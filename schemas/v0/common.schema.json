{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anamorfa.github.io/protocol/schemas/v0/common.schema.json",
  "title": "Common definitions",
  "description": "Identifiers shared by the other schemas.",
  "$defs": {
    "id": {
      "description": "Entity, definition or encounter id, e.g. scribe_1, formless_wanderer, rift_trial.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "text_key": {
      "description": "Catalog key, e.g. creature.formless_wanderer.name.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "content_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "essence": { "$ref": "#/$defs/content_id", "description": "Essence id from content, e.g. cut, pierce." },
    "form": { "$ref": "#/$defs/content_id", "description": "Form id from content, e.g. short_blade, projectile." },
    "grip": { "enum": ["one_hand", "two_hands"] },
    "slot": { "enum": ["main_hand", "off_hand"] },
    "hand": {
      "type": "object", "additionalProperties": false,
      "required": ["essence", "form", "grip"],
      "properties": { "essence": { "$ref": "#/$defs/essence" }, "form": { "$ref": "#/$defs/form" }, "grip": { "$ref": "#/$defs/grip" } }
    },
    "off_hand": {
      "type": "object", "additionalProperties": false,
      "required": ["essence", "form"],
      "properties": { "essence": { "$ref": "#/$defs/essence" }, "form": { "$ref": "#/$defs/form" } }
    },
    "gear_set": {
      "type": "object", "additionalProperties": false,
      "required": ["main_hand"],
      "properties": { "main_hand": { "$ref": "#/$defs/hand" }, "off_hand": { "$ref": "#/$defs/off_hand" } }
    },
    "wheel_matchup": { "enum": ["advantage", "neutral", "disadvantage"] },
    "line": { "enum": ["front", "middle", "rear"] },
    "side": { "enum": ["scribes", "enemies"] },
    "tile": {
      "description": "A map tile as [x, y]: x grows to the east, y to the south.",
      "type": "array", "minItems": 2, "maxItems": 2, "items": false,
      "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }]
    },
    "known_tile": {
      "description": "A tile the Scribe has seen, as [x, y, terrain id].",
      "type": "array", "minItems": 3, "maxItems": 3, "items": false,
      "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/content_id" }]
    },
    "facing": { "description": "One of the 8 directions; y grows to the south.", "enum": ["n", "ne", "e", "se", "s", "sw", "w", "nw"] },
    "named": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name_key"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name_key": { "$ref": "#/$defs/text_key" } }
    },
    "map_ref": {
      "description": "A map: its name, region and size. Its terrain arrives tile by tile as the Scribe sees it.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "name_key", "region", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name_key": { "$ref": "#/$defs/text_key" }, "region": { "$ref": "#/$defs/named" },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
      }
    },
    "world_entity": {
      "description": "An Anchor, a passage to another map or an enemy group the Scribe sees.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["id", "kind", "at"],
          "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "anchor" }, "at": { "$ref": "#/$defs/tile" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "kind", "at", "to"],
          "description": "Stepping on it takes the Scribe to the map to.",
          "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "passage" }, "at": { "$ref": "#/$defs/tile" },
                          "to": { "$ref": "#/$defs/named" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "kind", "at", "encounter", "tags"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "group" }, "at": { "$ref": "#/$defs/tile" },
            "encounter": {
              "type": "object", "additionalProperties": false, "required": ["id", "name_key", "level"],
              "properties": { "id": { "$ref": "#/$defs/id" }, "name_key": { "$ref": "#/$defs/text_key" },
                              "level": { "type": "integer", "minimum": 1 } }
            },
            "tags": { "description": "The tags of the group's creatures, sorted.", "type": "array",
                      "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
          } }
      ]
    }
  }
}
