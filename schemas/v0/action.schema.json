{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anamorfa.github.io/protocol/schemas/v0/action.schema.json",
  "title": "Action",
  "description": "What a client asks the server to do. Clients copy action, actor_id and params from an entry of available_actions; for a move_to they fill the target tile themselves.",
  "type": "object",
  "allOf": [{ "$ref": "#/$defs/fields" }],
  "unevaluatedProperties": false,
  "$defs": {
    "fields": {
      "type": "object",
      "required": ["action", "actor_id", "params"],
      "properties": {
        "action": { "enum": ["attack", "reshape", "fix", "move", "end_turn", "leave_rift", "move_to", "stop", "rest", "enter_rift"] },
        "actor_id": { "$ref": "common.schema.json#/$defs/id" },
        "params": { "type": "object" }
      },
      "oneOf": [
        { "type": "object", "properties": { "action": { "const": "attack" }, "params": { "$ref": "#/$defs/attack_params" } } },
        { "type": "object", "properties": { "action": { "const": "reshape" }, "params": { "$ref": "#/$defs/reshape_params" } } },
        { "type": "object", "properties": { "action": { "const": "fix" }, "params": { "$ref": "#/$defs/fix_params" } } },
        { "type": "object", "properties": { "action": { "const": "move" }, "params": { "$ref": "#/$defs/move_params" } } },
        { "type": "object", "properties": { "action": { "const": "end_turn" }, "params": { "$ref": "#/$defs/no_params" } } },
        { "type": "object", "properties": { "action": { "const": "leave_rift" }, "params": { "$ref": "#/$defs/no_params" } } },
        { "type": "object", "properties": { "action": { "const": "move_to" }, "params": { "$ref": "#/$defs/move_to_params" } } },
        { "type": "object", "properties": { "action": { "const": "stop" }, "params": { "$ref": "#/$defs/no_params" } } },
        { "type": "object", "properties": { "action": { "const": "rest" }, "params": { "$ref": "#/$defs/no_params" } } },
        { "type": "object", "properties": { "action": { "const": "enter_rift" }, "params": { "$ref": "#/$defs/enter_rift_params" } } }
      ]
    },
    "attack_params": {
      "type": "object",
      "required": ["target_id"],
      "properties": { "target_id": { "$ref": "common.schema.json#/$defs/id" } },
      "additionalProperties": false
    },
    "reshape_params": {
      "description": "Switch to the gear set at this 0-based index.",
      "type": "object",
      "required": ["set"],
      "properties": { "set": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "fix_params": {
      "type": "object",
      "required": ["target_id"],
      "properties": { "target_id": { "$ref": "common.schema.json#/$defs/id" } },
      "additionalProperties": false
    },
    "move_params": {
      "type": "object",
      "required": ["to"],
      "properties": { "to": { "$ref": "common.schema.json#/$defs/line" } },
      "additionalProperties": false
    },
    "no_params": { "type": "object", "maxProperties": 0 },
    "move_to_params": {
      "description": "Walk to this known tile of the current map, one step per tick.",
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "enter_rift_params": {
      "description": "Open a Rift with this group, which stands next to the Scribe.",
      "type": "object",
      "required": ["group_id"],
      "properties": { "group_id": { "$ref": "common.schema.json#/$defs/id" } },
      "additionalProperties": false
    }
  }
}
